{{ 'concept-page.css' | asset_url | stylesheet_tag }}
<div class="concept-page">
  <div class="wrap topbar"><a class="wordmark" href="{{ routes.root_url }}">SOMNUS</a><a class="toplink" href="{{ routes.root_url }}">Continue exploring</a></div>
  <div class="wrap" style="padding:80px 0;min-height:60vh">
    <div class="eyebrow">Your selection</div><h1 style="font-size:clamp(3rem,6vw,6rem);margin:12px 0 42px">Cart</h1>
    {% if cart.item_count == 0 %}
      <p>Your cart is empty.</p><p style="margin-top:28px"><a class="button" href="{{ routes.root_url }}">Return to home</a></p>
    {% else %}
      <form action="{{ routes.cart_url }}" method="post">
        {% for item in cart.items %}
          <div style="display:grid;grid-template-columns:90px 1fr auto;align-items:center;gap:22px;border-top:1px solid var(--line);padding:20px 0">
            <div style="width:90px;height:90px;background:var(--panel)">{% if item.image %}{{ item.image | image_url: width: 180 | image_tag: loading: 'lazy', alt: item.product.title }}{% endif %}</div>
            <div><a href="{{ item.url }}">{{ item.product.title | escape }}</a><p>{{ item.variant.title | escape }}</p><label for="quantity-{{ forloop.index }}">Quantity</label> <input id="quantity-{{ forloop.index }}" type="number" min="0" name="updates[]" value="{{ item.quantity }}" style="width:70px;padding:6px;border:1px solid var(--line)"></div>
            <div>{{ item.final_line_price | money }}</div>
          </div>
        {% endfor %}
        <div style="border-top:1px solid var(--line);padding:30px 0;text-align:right"><p>Subtotal: <strong>{{ cart.total_price | money }}</strong></p><p style="margin-top:22px"><button class="button" type="submit" name="update">Update cart</button> <button class="button" type="submit" name="checkout">Checkout</button></p></div>
      </form>
    {% endif %}
  </div>
</div>
