{% comment %}
  Shopify 2.0 Product Page Section - SOMNUS Sleep & Relaxation Formula
  Tailored by Senior Shopify Plus Developer & CRO Specialist
  Stiles based on NATURAL TONES aesthetic.
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet font-display: swap">

<style>
  :root {
    --midnight: {{ section.settings.color_midnight | default: '#0F1626' }};
    --sand: {{ section.settings.color_sand | default: '#DCCDB2' }};
    --chalk: {{ section.settings.color_chalk | default: '#F5F3EE' }};
    --matte: {{ section.settings.color_matte | default: '#111418' }};
  }

  .somnus-wrapper {
    font-family: 'Montserrat', sans-serif;
    background-color: var(--chalk);
    color: var(--matte);
    scroll-behavior: smooth;
  }

  .somnus-serif {
    font-family: 'Cormorant Garamond', Georgia, serif;
  }

  .premium-badge {
    text-transform: uppercase;
    font-size: 10px;
    letter-spacing: 2px;
    font-weight: 700;
    color: var(--midnight);
    border: 1px solid var(--midnight);
    padding: 4px 12px;
    border-radius: 100px;
    display: inline-block;
  }

  .buy-now-btn {
    background-color: var(--midnight);
    color: var(--chalk);
    transition: all 0.3s ease;
  }

  .buy-now-btn:hover {
    opacity: 0.95;
    background-color: var(--matte);
  }

  .benefit-card-luxury {
    background-color: var(--matte);
    border: 1px solid rgba(220, 205, 178, 0.15);
  }
</style>

<div class="somnus-wrapper py-10 px-4 md:px-12">
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10">
    
    <!-- GALLERY BLOCK -->
    <div class="lg:col-span-7 space-y-6">
      <div class="relative rounded-3xl overflow-hidden bg-white p-6 aspect-[4/5] flex items-center justify-center">
        <!-- Main Product Image -->
        <img 
          src="{{ product.featured_image | img_url: '800x' | default: 'https://images.unsplash.com/photo-1540518614846-7eded433c457?auto=format&fit=crop&q=80&w=800' }}" 
          alt="SOMNUS Sleep Formula"
          class="max-h-[85%] object-contain"
          id="MainProductPhoto"
        >
      </div>
      
      <!-- Thumbnails -->
      <div class="grid grid-cols-5 gap-3">
        {% for image in product.images %}
          <div class="aspect-square bg-gray-50 rounded-xl overflow-hidden cursor-pointer border hover:border-black p-1">
            <img src="{{ image.src | img_url: '150x150', crop: 'center' }}" class="w-full h-full object-cover rounded-lg">
          </div>
        {% endfor %}
      </div>
    </div>

    <!-- PRODUCT ARRANGE CONTENT BLOCK -->
    <div class="lg:col-span-5 space-y-6">
      <div class="space-y-2">
        <span class="text-xs uppercase tracking-widest text-[#DCCDB2] font-semibold">{{ section.settings.kicker_text }}</span>
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-[#0F1626] somnus-serif leading-tight">
          {{ product.title | default: "SOMNUS Sleep & Relaxation Formula" }}
        </h1>
      </div>

      <!-- PRICE AREA -->
      <div class="flex items-baseline space-x-3 py-2 border-b border-gray-200">
        <span class="text-3xl font-bold tracking-tight text-[#0F1626] sm-serif">
          {{ product.price | money | default: "$71.40" }}
        </span>
        {% if product.compare_at_price > product.price %}
          <span class="text-sm line-through text-gray-400">
            {{ product.compare_at_price | money | default: "$84.00" }}
          </span>
        {% endif %}
      </div>

      <!-- DESCRIPTION -->
      <div class="text-sm text-gray-700 leading-relaxed space-y-4">
        {{ product.description | default: "A premium slow-wave neuromodulator formulated specifically to decrease sleep onset latency and maximize restorative deep-sleep amplitudes." }}
      </div>

      <!-- SHOPIFY CART FORM -->
      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        
        <!-- Subscription Block (DTC Hack) -->
        <div class="border rounded-2xl p-4 bg-white space-y-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-2">
              <input type="radio" id="sub" name="purchase_option" checked class="accent-[#0F1626]">
              <label for="sub" class="text-xs font-bold uppercase tracking-wider text-[#0F1626]">Subscribe &amp; Save (15%)</label>
            </div>
            <span class="text-xs font-bold text-[#DCCDB2]">{{ product.price | times: 0.85 | money | default: "$71.40" }}</span>
          </div>
        </div>

        <div class="pt-4 space-y-3">
          <button type="submit" class="w-full buy-now-btn font-bold uppercase tracking-widest py-4 rounded-xl text-xs">
            Add to sleep cycle
          </button>
        </div>
      {% endform %}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "SOMNUS Premium Page",
  "settings": [
    {
      "type": "text",
      "id": "kicker_text",
      "label": "Kicker text",
      "default": "ST-09 CIRCADIAN SUPPLEMENT"
    },
    {
      "type": "color",
      "id": "color_midnight",
      "label": "Midnight Indigo Color",
      "default": "#0F1626"
    },
    {
      "type": "color",
      "id": "color_sand",
      "label": "Soft Warm Sand Color",
      "default": "#DCCDB2"
    },
    {
      "type": "color",
      "id": "color_chalk",
      "label": "Chalk White Background",
      "default": "#F5F3EE"
    },
    {
      "type": "color",
      "id": "color_matte",
      "label": "Matte Soft Black Color",
      "default": "#111418"
    }
  ],
  "presets": [
    {
      "name": "SOMNUS Premium Page",
      "category": "Product"
    }
  ]
}
{% endschema %}
